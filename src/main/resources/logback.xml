<configuration>
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>[%d{HH:mm:ss}] [%thread/%-5level] %logger{36}: %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Enable debug for sound events -->
    <logger name="net.minecraft.sounds.SoundEvents" level="ALL"/>
    <logger name="net.minecraft.sounds" level="ALL"/>

    <root level="INFO">
        <appender-ref ref="STDOUT"/>
    </root>
</configuration>